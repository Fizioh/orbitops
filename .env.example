# OrbitOps — local / demo environment
# Copy to .env and adjust. Never commit real secrets.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ORBITOPS_ENV=demo
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production-use-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo mode: seed data, no external commercial services required
DEMO_MODE=true
DEMO_SEED_ON_STARTUP=false

# ---------------------------------------------------------------------------
# Database (PostgreSQL + PostGIS)
# ---------------------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=orbitops
POSTGRES_USER=orbitops
POSTGRES_PASSWORD=orbitops_dev_password

# ---------------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---------------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_BASE_URL=ws://localhost:8000/ws
VITE_DEMO_MODE=true
# Cesium Ion token is optional; demo works with offline/default imagery
VITE_CESIUM_ION_TOKEN=

# ---------------------------------------------------------------------------
# Observability (optional for local)
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=orbitops

# ---------------------------------------------------------------------------
# AWS (Terraform / production demo only — leave empty for local)
# ---------------------------------------------------------------------------
AWS_REGION=eu-west-1
AWS_ACCOUNT_ID=
